# 复制为 .env 后按需修改：cp .env.example .env
# 该文件不含任何真实密钥，也不会被提交（见 .gitignore）

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=change-me-in-production
MYSQL_DATABASE=smart_inventory

# ===== 后端连接 =====
DB_USERNAME=root
DB_PASSWORD=change-me-in-production

# ===== Redis（可选，仅限流使用；不可用时自动降级）=====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# ===== 上传目录（生产必须指向独立数据目录）=====
UPLOAD_PATH=/data/uploads

# ===== 跨域白名单（生产必须显式配置，逗号分隔）=====
CORS_ALLOWED_ORIGINS=http://localhost:8088

# ===== AI（可选）=====
# provider: auto（本地优先，失败降级云端）| local | cloud
AI_PROVIDER=auto
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:0.8b
ALIYUN_API_KEY=
ALIYUN_API_SECRET=

# ===== 端口映射 =====
BACKEND_PORT=8080
WEB_PORT=8088
